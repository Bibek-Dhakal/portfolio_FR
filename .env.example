# Site URL (e.g. https://example.com). Used for sitemap generation.
NEXT_PUBLIC_SITE_URL=

# Public URL to your CV/resume (PDF). Used by the Contact and About pages.
# Can point to a file in /public (e.g. "Bibek_Dhakal_Resume.pdf") or an
# external link (Google Drive, etc.).
NEXT_PUBLIC_CV_URL=

# Web3Forms access key.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=
